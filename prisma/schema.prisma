generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelStatus {
  open
  closing
  closed
}

enum ChannelEventType {
  opened
  settled
  top_up
  close_requested
  close_cancelled
  closed
}

model Channel {
  channelId   String         @id @map("channel_id")
  payer       String
  payee       String
  operator    String
  token       String
  deposit     Decimal        @db.Decimal(20, 6)
  settled     Decimal        @db.Decimal(20, 6)
  refunded    Decimal        @db.Decimal(20, 6)
  status      ChannelStatus
  openedAt    DateTime       @map("opened_at")
  lastEventAt DateTime       @map("last_event_at")
  closedAt    DateTime?      @map("closed_at")
  events      ChannelEvent[]

  @@index([openedAt])
  @@index([status])
  @@index([payer])
  @@index([payee])
  @@index([deposit])
  @@index([settled])
  @@map("channels")
}

model ChannelEvent {
  channelId String           @map("channel_id")
  channel   Channel          @relation(fields: [channelId], references: [channelId])
  type      ChannelEventType
  txHash    String           @map("tx_hash")
  logIndex  Int              @map("log_index")
  blockNum  Int              @map("block_num")
  ts        DateTime
  amounts   Json
  volume    Decimal          @default(0) @db.Decimal(20, 6)

  @@id([txHash, logIndex])
  @@index([channelId, blockNum, logIndex])
  @@index([ts])
  @@map("channel_events")
}

model SyncCursor {
  id           Int @id
  fromBlock    Int @map("from_block")
  fromLogIndex Int @map("from_log_index")

  @@map("sync_cursor")
}

model ChannelDaily {
  day      DateTime      @db.Date
  status   ChannelStatus
  sessions Int

  @@id([day, status])
  @@map("channel_daily")
}

model VolumeDaily {
  day    DateTime      @db.Date
  status ChannelStatus
  volume Decimal       @db.Decimal(20, 6)
  events Int

  @@id([day, status])
  @@map("volume_daily")
}

model PayerFirstSeen {
  payer    String
  status   ChannelStatus
  firstDay DateTime      @map("first_day") @db.Date

  @@id([payer, status])
  @@map("payer_first_seen")
}
