{
  "name": "sessionscan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "biome check . && tsc --noEmit && DATABASE_URL=postgresql://localhost:5432/sessionscan knip",
    "sync": "curl -sf -H \"Authorization: Bearer ${CRON_SECRET:-local-dev-secret}\" http://localhost:3000/api/cron/sync",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:sql": "set -a && . ./.env.local && set +a && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/sql/aggregates.sql",
    "db:prep": "set -a && . ./.env.local && set +a && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/sql/prep.sql",
    "db:reclaim": "set -a && . ./.env.local && set +a && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/sql/reclaim.sql",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.2.12",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.55.17",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "knip": "^6.32.2",
    "prisma": "^7.9.1",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
